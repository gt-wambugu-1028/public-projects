// devcontainer.json
{
  "name": "ubuntu_devcontainer",
  "build": {
      "dockerfile": "Dockerfile"
  },
  "shutdownAction": "stopContainer",
  "forwardPorts": [443],
  "portsAttributes": {
    "443": { "label": "HTTPS", "onAutoForward": "silent" },
  },
  "remoteUser": "ubuntu",
  "mounts": [
    "source=${localEnv:USERPROFILE}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.git-credentials,target=/home/ubuntu/.git-credentials,type=bind,consistency=cached",
    "source=${localEnv:USERPROFILE}/.claude,target=/home/ubuntu/.claude,type=bind,consistency=cached",
  ],
  // "RunArgs": ["--env-file", "<PATH_TO_ENV_FILE>"]
  // "workspaceMount": "source=,target=,type=,consistency="
  // "workspaceFolder": "<workspaceMountTarget>",
  // "dockerComposeFile": "[<Docker Compose file path>]",
  // "service": "",
}
